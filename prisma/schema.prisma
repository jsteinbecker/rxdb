      package Package? @relation(fields: [packageId], references: [id])

      @@map("component_in_use_limit")
}

model PreparationSpec {
      id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      scopeId         String                  @map("scope_id") @db.Uuid
      kind            CompoundingKind
      budCategory     String                  @map("bud_category")
      diluentTermId   String?                 @map("diluent_term_id") @db.Uuid
      containerTermId String?                 @map("container_term_id") @db.Uuid
      finalVolumeMag  Decimal?                @map("final_volume_mag") @db.Decimal
      finalVolumeUom  String?                 @default("mL") @map("final_volume_uom")
      /// @generated
      finalVolume     Unsupported("measure")? @default(dbgenerated()) @map("final_volume")
      storage         StorageCondition
      lightProtected  Boolean                 @default(false) @map("light_protected")

      scope                  Scope                   @relation(fields: [scopeId], references: [id])
      diluentTerm            CompoundingTerm?        @relation("PrepDiluent", fields: [diluentTermId], references: [id])
      containerTerm          CompoundingTerm?        @relation("PrepContainer", fields: [containerTermId], references: [id])
      preparationIngredients PreparationIngredient[]
      buildPlans             BuildPlan[]

      @@map("preparation_spec")
}

model PreparationIngredient {
      preparationId    String                  @map("preparation_id") @db.Uuid
      ingredientTermId String                  @map("ingredient_term_id") @db.Uuid
      finalConcMag     Decimal                 @map("final_conc_mag") @db.Decimal
      finalConcUom     String                  @map("final_conc_uom")
      /// @generated
      finalConc        Unsupported("measure")? @default(dbgenerated()) @map("final_conc")

      preparation    PreparationSpec @relation(fields: [preparationId], references: [id], onDelete: Cascade)
      ingredientTerm CompoundingTerm @relation(fields: [ingredientTermId], references: [id])

      @@id([preparationId, ingredientTermId])
      @@map("preparation_ingredient")
}

model CompoundFormula {
      id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      scopeId          String           @map("scope_id") @db.Uuid
      formularyItemId  String?          @map("formulary_item_id") @db.Uuid
      kind             CompoundingKind
      name             String
      budCategory      String           @map("bud_category")
      defaultStorage   StorageCondition @map("default_storage")
      version          Int              @default(1)
      status           String           @default("draft")
      approvedBy       String?          @map("approved_by") @db.Uuid
      approvedAt       DateTime?        @map("approved_at") @db.Timestamptz(6)
      /// explicit total volume, mixed number in `totalVolumeUom` (mL); null = sum of component volumes
      totalVolumeWhole BigInt?          @map("total_volume_whole")
      totalVolumeNum   BigInt?          @map("total_volume_num")
      totalVolumeDen   BigInt?          @map("total_volume_den")
      totalVolumeUom   String?          @map("total_volume_uom")

      scope         Scope          @relation(fields: [scopeId], references: [id])
      formularyItem FormularyItem? @relation(fields: [formularyItemId], references: [id])
      formulaSlots  FormulaSlot[]
      buildPlans    BuildPlan[]

      @@unique([scopeId, name, version])
      @@map("compound_formula")
}

model FormulaSlot {
      id                  String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      formulaId           String                           @map("formula_id") @db.Uuid
      role                String
      ingredientTermId    String?                          @map("ingredient_term_id") @db.Uuid
      /// mixed-number amount per unit of preparation, e.g. 1 1/2 tsp
      targetAmountWhole   BigInt?                          @map("target_amount_whole")
      targetAmountNum     BigInt?                          @default(0) @map("target_amount_num")
      targetAmountDen     BigInt?                          @default(1) @map("target_amount_den")
      targetAmountUom     String?                          @map("target_amount_uom")
      /// @generated
      targetAmount        Unsupported("rational_measure")? @default(dbgenerated()) @map("target_amount")
      targetConcMag       Decimal?                         @map("target_conc_mag") @db.Decimal
      targetConcUom       String?                          @map("target_conc_uom")
      /// @generated
      targetConc          Unsupported("measure")?          @default(dbgenerated()) @map("target_conc")
      /// component volume, mixed number in `volumeUom` (mL)
      volumeWhole         BigInt?                          @map("volume_whole")
      volumeNum           BigInt?                          @map("volume_num")
      volumeDen           BigInt?                          @map("volume_den")
      volumeUom           String?                          @map("volume_uom")
      tolerancePct        Decimal                          @default(0) @map("tolerance_pct") @db.Decimal
      allowMultiComponent Boolean                          @default(true) @map("allow_multi_component")
      ordinal             Int                              @default(1)

      formula        CompoundFormula  @relation(fields: [formulaId], references: [id], onDelete: Cascade)
      ingredientTerm CompoundingTerm? @relation(fields: [ingredientTermId], references: [id])
      slotCandidates SlotCandidate[]
      buildPlanLines BuildPlanLine[]

      @@map("formula_slot")
}

model SlotCandidate {
      slotId                      String                    @map("slot_id") @db.Uuid
      packageId                   String                    @map("package_id") @db.Uuid
      preferenceRank              Int                       @default(1) @map("preference_rank")
      isRestricted                Boolean                   @default(false) @map("is_restricted")
      sourceConcMag               Decimal?                  @map("source_conc_mag") @db.Decimal
      sourceConcUom               String?                   @map("source_conc_uom")
      /// @generated
      sourceConc                  Unsupported("measure")?   @default(dbgenerated()) @map("source_conc")
      requiresReconstitution      Boolean                   @default(false) @map("requires_reconstitution")
      reconstitutionDiluentTermId String?                   @map("reconstitution_diluent_term_id") @db.Uuid
      reconstitutedVolumeMag      Decimal?                  @map("reconstituted_volume_mag") @db.Decimal
      reconstitutedVolumeUom      String?                   @default("mL") @map("reconstituted_volume_uom")
      /// @generated
      reconstitutedVolume         Unsupported("measure")?   @default(dbgenerated()) @map("reconstituted_volume")
      note                        String?
      validFrom                   DateTime                  @default(now()) @map("valid_from") @db.Timestamptz(6)
      validTo                     DateTime?                 @map("valid_to") @db.Timestamptz(6)
      /// @generated
      validPeriod                 Unsupported("tstzrange")? @default(dbgenerated()) @map("valid_period")

      slot                      FormulaSlot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
      package                   Package          @relation(fields: [packageId], references: [id])
      reconstitutionDiluentTerm CompoundingTerm? @relation(fields: [reconstitutionDiluentTermId], references: [id])

      @@id([slotId, packageId])
      @@map("slot_candidate")
}

model ComponentCost {
      id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      packageId   String                    @map("package_id") @db.Uuid
      scopeId     String                    @map("scope_id") @db.Uuid
      costPerUnit Decimal                   @map("cost_per_unit") @db.Decimal
      currency    String                    @default("USD")
      basis       String?
      validFrom   DateTime                  @default(now()) @map("valid_from") @db.Timestamptz(6)
      validTo     DateTime?                 @map("valid_to") @db.Timestamptz(6)
      /// @generated
      validPeriod Unsupported("tstzrange")? @default(dbgenerated()) @map("valid_period")

      package Package @relation(fields: [packageId], references: [id])
      scope   Scope   @relation(fields: [scopeId], references: [id])

      @@map("component_cost")
}

model ComponentAvailability {
      id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      packageId             String            @map("package_id") @db.Uuid
      scopeId               String            @map("scope_id") @db.Uuid
      state                 AvailabilityState
      onHandUnits           Decimal?          @map("on_hand_units") @db.Decimal
      allocationUnitsPerDay Decimal?          @map("allocation_units_per_day") @db.Decimal
      conserveWeight        Decimal           @default(0) @map("conserve_weight") @db.Decimal
      source                String?
      observedAt            DateTime          @default(now()) @map("observed_at") @db.Timestamptz(6)

      package Package @relation(fields: [packageId], references: [id])
      scope   Scope   @relation(fields: [scopeId], references: [id])

      @@index([packageId, scopeId, observedAt(sort: Desc)])
      @@map("component_availability")
}

model OptimizerProfile {
      id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      scopeId              String                  @map("scope_id") @db.Uuid
      name                 String
      wComponentCount      Decimal                 @default(1) @map("w_component_count") @db.Decimal
      wCost                Decimal                 @default(1) @map("w_cost") @db.Decimal
      wWasteCost           Decimal                 @default(1) @map("w_waste_cost") @db.Decimal
      wWasteVolume         Decimal                 @default(0) @map("w_waste_volume") @db.Decimal
      wPreference          Decimal                 @default(1) @map("w_preference") @db.Decimal
      allowRestricted      Boolean                 @default(false) @map("allow_restricted")
      allowVialSharing     Boolean                 @default(true) @map("allow_vial_sharing")
      minBudMag            Decimal?                @map("min_bud_mag") @db.Decimal
      minBudUom            String?                 @default("h") @map("min_bud_uom")
      /// @generated reject plans that expire sooner
      minBud               Unsupported("measure")? @default(dbgenerated()) @map("min_bud")
      maxComponentsPerSlot Int                     @default(6) @map("max_components_per_slot")

      scope      Scope       @relation(fields: [scopeId], references: [id])
      buildPlans BuildPlan[]

      @@unique([scopeId, name])
      @@map("optimizer_profile")
}

model BuildPlan {
      id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      scopeId               String                  @map("scope_id") @db.Uuid
      formulaId             String                  @map("formula_id") @db.Uuid
      profileId             String                  @map("profile_id") @db.Uuid
      batchUnits            Int                     @default(1) @map("batch_units")
      preparationId         String?                 @map("preparation_id") @db.Uuid
      objectiveValue        Decimal?                @map("objective_value") @db.Decimal
      totalCost             Decimal?                @map("total_cost") @db.Decimal
      totalWasteMag         Decimal?                @map("total_waste_mag") @db.Decimal
      totalWasteUom         String?                 @default("mL") @map("total_waste_uom")
      /// @generated
      totalWaste            Unsupported("measure")? @default(dbgenerated()) @map("total_waste")
      totalWasteCost        Decimal?                @map("total_waste_cost") @db.Decimal
      componentCount        Int?                    @map("component_count")
      budMag                Decimal?                @map("bud_mag") @db.Decimal
      budUom                String?                 @default("h") @map("bud_uom")
      /// @generated
      bud                   Unsupported("measure")? @default(dbgenerated())
      budLimitingFactor     String?                 @map("bud_limiting_factor")
      rankAmongAlternatives Int?                    @map("rank_among_alternatives")
      solverVersion         String                  @map("solver_version")
      inputsSnapshot        Json                    @map("inputs_snapshot")
      status                String                  @default("proposed")
      createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

      scope             Scope              @relation(fields: [scopeId], references: [id])
      formula           CompoundFormula    @relation(fields: [formulaId], references: [id])
      profile           OptimizerProfile   @relation(fields: [profileId], references: [id])
      preparation       PreparationSpec?   @relation(fields: [preparationId], references: [id])
      buildPlanLines    BuildPlanLine[]
      buildPlanFindings BuildPlanFinding[]
      openComponents    OpenComponent[]

      @@map("build_plan")
}

model BuildPlanLine {
      planId              String                  @map("plan_id") @db.Uuid
      slotId              String                  @map("slot_id") @db.Uuid
      packageId           String                  @map("package_id") @db.Uuid
      units               Int
      drawnMag            Decimal?                @map("drawn_mag") @db.Decimal
      drawnUom            String?                 @default("mL") @map("drawn_uom")
      /// @generated
      drawn               Unsupported("measure")? @default(dbgenerated())
      residualMag         Decimal?                @map("residual_mag") @db.Decimal
      residualUom         String?                 @default("mL") @map("residual_uom")
      /// @generated
      residual            Unsupported("measure")? @default(dbgenerated())
      residualDisposition String?                 @map("residual_disposition")
      retainedUntil       DateTime?               @map("retained_until") @db.Timestamptz(6)
      lineCost            Decimal?                @map("line_cost") @db.Decimal
      wasteCost           Decimal?                @map("waste_cost") @db.Decimal

      plan    BuildPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
      slot    FormulaSlot @relation(fields: [slotId], references: [id])
      package Package     @relation(fields: [packageId], references: [id])

      @@id([planId, slotId, packageId])
      @@map("build_plan_line")
}

model BuildPlanFinding {
      id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      planId   String  @map("plan_id") @db.Uuid
      ruleId   String? @map("rule_id") @db.Uuid
      severity String
      detail   String

      plan BuildPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
      rule CompoundingRule? @relation(fields: [ruleId], references: [id])

      @@map("build_plan_finding")
}

model OpenComponent {
      id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      scopeId        String                  @map("scope_id") @db.Uuid
      packageId      String                  @map("package_id") @db.Uuid
      lot            String?
      expiresLot     DateTime?               @map("expires_lot") @db.Date
      openedAt       DateTime                @map("opened_at") @db.Timestamptz(6)
      inUseUntil     DateTime                @map("in_use_until") @db.Timestamptz(6)
      remainingMag   Decimal                 @map("remaining_mag") @db.Decimal
      remainingUom   String                  @default("mL") @map("remaining_uom")
      /// @generated
      remaining      Unsupported("measure")? @default(dbgenerated())
      environment    String
      openedByPlanId String?                 @map("opened_by_plan") @db.Uuid
      closedAt       DateTime?               @map("closed_at") @db.Timestamptz(6)

      scope        Scope      @relation(fields: [scopeId], references: [id])
      package      Package    @relation(fields: [packageId], references: [id])
      openedByPlan BuildPlan? @relation(fields: [openedByPlanId], references: [id])

      @@map("open_component")
}

/// Dosing measure chosen for a combination SCD concept (`rxcui:…` or `pscd:…`).
/// Keyed by concept so every NDC under it shares one selection.
model ScdDosingMeasure {
      conceptKey String   @id @map("concept_key")
      mode       String
      ingredient String?
      /// For `sum`: the moiety groups summed; empty sums every ingredient.
      ingredients String[] @default([])
      updatedAt  DateTime @updatedAt @map("updated_at")

      @@map("scd_dosing_measure")
}

/// Where a label photo (`SPLIMAGE`) shows each imprint section, measured by
/// `pill-image-analyze`. Keyed by the label's set ID and the photo's file
/// name; `analyzerVersion` lets a better analyzer re-measure old rows.
model PillImageLayout {
      setId           String   @map("set_id")
      image           String
      /// The imprint the photo was measured against; a new label version may change it.
      imprint         String
      analyzerVersion Int      @map("analyzer_version")
      /// `measured`, `no-pill` (nothing separable), or `failed` (fetch/decode error).
      status          String
      layout          Json?
      error           String?
      analyzedAt      DateTime @default(now()) @map("analyzed_at") @db.Timestamptz(6)

      @@id([setId, image])
      @@map("pill_image_layout")
}

/// Which photo shows a package's pill, looked up when its label names none:
/// the label re-read, then NLM's C3PI archive. `part` is the appearance's
/// position in the package (a kit's parts look different). A row with no
/// image records that nothing was found, and is looked up again later.
model PillPhoto {
      ndc       String
      part      Int
      setId     String?  @map("set_id")
      image     String?
      checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

      @@id([ndc, part])
      @@map("pill_photo")
}

/// What FDA's GSRS says about one UNII: the molecular weight and active moiety
/// the ingredient correction wizard converts strengths with. `mw` is null for
/// substances without a structure (proteins, mixtures); `notFound` caches a
/// UNII GSRS does not know. `raw` is the trimmed response the row was read from.
model UniiSubstance {
      unii        String   @id
      name        String?
      formula     String?
      mw          Float?
      moietyUnii  String?  @map("moiety_unii")
      moietyName  String?  @map("moiety_name")
      moietyCount Int?     @map("moiety_count")
      notFound    Boolean  @default(false) @map("not_found")
      raw         Json?
      fetchedAt   DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

      @@map("unii_substance")
}

model PharmClassRule {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scopeId       String   @map("scope_id") @db.Uuid
  moietyKey     String   @map("moiety_key")
  moietyNames   String   @map("moiety_names")
  doseFormGroup String?  @map("dose_form_group")
  route         String?
  strengthKey   String?  @map("strength_key")
  mode          String   @default("replace")
  classes       String[]
  note          String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  scope Scope @relation(fields: [scopeId], references: [id])

  @@unique([scopeId, moietyKey, doseFormGroup, route, strengthKey], map: "pharm_class_rule_key")
  @@index([scopeId, moietyKey])
  @@map("pharm_class_rule")
}

/// A row of the CMS quarterly NDC–HCPCS crosswalk for Medicare Part B (ASP, OPPS, AWP, PrEP files).
/// Replaced whole when a newer quarter is published; see `cms-billing.ts`.
model CmsCrosswalkRow {
      ndc11        String
      hcpcs        String
      /// Which crosswalk file the row came from: ASP, OPPS, AWP or PrEP.
      file         String
      descriptor   String?
      labelerName  String?  @map("labeler_name")
      drugName     String?  @map("drug_name")
      /// The HCPCS code's dosage descriptor ("1 MG", "0.5 ML").
      hcpcsDosage  String?  @map("hcpcs_dosage")
      pkgSize      Float?   @map("pkg_size")
      pkgQty       Float?   @map("pkg_qty")
      billUnits    Float?   @map("bill_units")
      billUnitsPkg Float?   @map("bill_units_pkg")
      /// "October 2026", the quarter the file covers.
      quarter      String
      sourceUrl    String   @map("source_url")
      fetchedAt    DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

      @@id([ndc11, hcpcs, file])
      @@index([ndc11])
      @@map("cms_crosswalk_row")
}
