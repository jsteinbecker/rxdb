// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
      provider        = "prisma-client"
      output          = "../src/generated"
      previewFeatures = ["typedSql"]
}

datasource db {
      provider = "postgresql"
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------
enum ScopeKind {
      global
      org
      site
      formulary

      @@map("scope_kind")
}

enum EntityType {
      package
      product
      clinical_drug
      ingredient
      labeler
      spl
      formulary_item

      @@map("entity_type")
}

enum ValueType {
      text
      code
      number
      quantity
      rational
      boolean
      date
      entity_ref
      json

      @@map("value_type")
}

enum ResolutionState {
      asserted
      derived
      overridden
      conflicted
      unknown

      @@map("resolution_state")
}

enum MappingType {
      exact
      equivalent
      broader
      narrower
      candidate
      supersedes

      @@map("mapping_type")
}

enum StrengthBasis {
      as_labeled
      active_moiety
      salt

      @@map("strength_basis")
}

enum StorageCondition {
      controlled_room
      refrigerated
      frozen

      @@map("storage_condition")
}

enum CompoundingKind {
      sterile
      nonsterile

      @@map("compounding_kind")
}

enum TermKind {
      ingredient
      ingredient_class
      product
      diluent
      container_material
      device_feature
      vehicle

      @@map("term_kind")
}

enum RuleContext {
      same_container
      y_site
      syringe
      contact
      vehicle

      @@map("rule_context")
}

enum RuleEffect {
      prohibit
      require
      avoid
      prefer
      informational

      @@map("rule_effect")
}

enum CompatVerdict {
      compatible
      incompatible
      conditional
      variable
      no_data

      @@map("compat_verdict")
}

enum AvailabilityState {
      available
      constrained
      allocated
      shortage
      unavailable

      @@map("availability_state")
}

// ---------------------------------------------------------------------
// 0. Scopes
// ---------------------------------------------------------------------
model Scope {
      id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      kind     ScopeKind
      parentId String?   @map("parent_id") @db.Uuid
      name     String
      /// Per-scope preferences; see src/lib/settings.ts.
      settings Json      @default("{}")

      parent                    Scope?                     @relation("ScopeParent", fields: [parentId], references: [id])
      children                  Scope[]                    @relation("ScopeParent")
      formularyItems            FormularyItem[]
      factAssertions            FactAssertion[]
      resolutionPolicies        ResolutionPolicy[]
      propertyValues            PropertyValue[]
      entityMappings            EntityMapping[]
      reviewItems               ReviewItem[]
      derivationDirties         DerivationDirty[]
      propertyGroupIndexes      PropertyGroupIndex[]
      packageCatalogProjections PackageCatalogProjection[]
      catalogViews              CatalogView[]
      termMemberships           TermMembership[]
      compoundingRules          CompoundingRule[]
      budRegulatoryLimits       BudRegulatoryLimit[]
      stabilityCells            StabilityCell[]
      componentInUseLimits      ComponentInUseLimit[]
      preparationSpecs          PreparationSpec[]
      compoundFormulas          CompoundFormula[]
      componentCosts            ComponentCost[]
      componentAvailabilities   ComponentAvailability[]
      optimizerProfiles         OptimizerProfile[]
      buildPlans                BuildPlan[]
      openComponents            OpenComponent[]
      pharmClassRules           PharmClassRule[]

      @@map("scope")
}

// ---------------------------------------------------------------------
// 1. Core entities
// ---------------------------------------------------------------------
model Entity {
      id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      type       EntityType
      status     String     @default("active")
      mergedInto String?    @map("merged_into") @db.Uuid
      createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
      retiredAt  DateTime?  @map("retired_at") @db.Timestamptz(6)

      mergedIntoEntity       Entity?              @relation("EntityMerge", fields: [mergedInto], references: [id])
      mergedFrom             Entity[]             @relation("EntityMerge")
      relationshipsFrom      EntityRelationship[] @relation("RelationshipFrom")
      relationshipsTo        EntityRelationship[] @relation("RelationshipTo")
      assertions             FactAssertion[]      @relation("AssertionSubject")
      referencedByAssertions FactAssertion[]      @relation("AssertionRef")
      values                 PropertyValue[]      @relation("ValueSubject")
      referencedByValues     PropertyValue[]      @relation("ValueRef")
      mappingsAsSubject      EntityMapping[]      @relation("MappingSubject")
      mappingsAsObject       EntityMapping[]      @relation("MappingObject")
      labeler                Labeler?
      ingredient             Ingredient?
      product                Product?
      clinicalDrug           ClinicalDrug?
      package                Package?
      formularyItem          FormularyItem?
      externalIdentifiers    ExternalIdentifier[]
      reviewItems            ReviewItem[]
      derivationDirties      DerivationDirty[]
      propertyGroupIndexes   PropertyGroupIndex[]
      compoundingTerms       CompoundingTerm[]

      @@unique([id, type])
      @@map("entity")
}

model Labeler {
      id   String     @id @db.Uuid
      type EntityType @default(labeler)
      name String

      entity                    Entity                     @relation(fields: [id, type], references: [id, type])
      products                  Product[]
      packageCatalogProjections PackageCatalogProjection[]

      @@unique([id, type])
      @@map("labeler")
}

model Ingredient {
      id             String     @id @db.Uuid
      type           EntityType @default(ingredient)
      name           String
      activeMoietyId String?    @map("active_moiety_id") @db.Uuid

      entity                 Entity              @relation(fields: [id, type], references: [id, type])
      activeMoiety           Ingredient?         @relation("IngredientMoiety", fields: [activeMoietyId], references: [id])
      salts                  Ingredient[]        @relation("IngredientMoiety")
      productIngredients     ProductIngredient[] @relation("ProductIngredientPrecise")
      productIngredientBases ProductIngredient[] @relation("ProductIngredientBasis")

      @@unique([id, type])
      @@map("ingredient")
}

model Product {
      id              String     @id @db.Uuid
      type            EntityType @default(product)
      labelerId       String     @map("labeler_id") @db.Uuid
      proprietaryName String?    @map("proprietary_name")
      doseForm        String?    @map("dose_form")
      isKit           Boolean    @default(false) @map("is_kit")

      entity             Entity              @relation(fields: [id, type], references: [id, type])
      labeler            Labeler             @relation(fields: [labelerId], references: [id])
      packageComponents  PackageComponent[]
      productIngredients ProductIngredient[]

      @@unique([id, type])
      @@map("product")
}

model ClinicalDrug {
      id   String     @id @db.Uuid
      type EntityType @default(clinical_drug)
      name String
      tty  String?

      entity       Entity        @relation(fields: [id, type], references: [id, type])
      localConcept LocalConcept?

      @@unique([id, type])
      @@map("clinical_drug")
}

model LocalConcept {
      id              String   @id @db.Uuid
      genericId       String?  @map("generic_id") @db.Uuid
      brandName       String?  @map("brand_name")
      doseForm        String   @map("dose_form")
      evidenceSetId   String   @map("evidence_set_id")
      evidenceVersion String   @map("evidence_version")
      evidenceNdc     String?  @map("evidence_ndc")
      ionicContent    Json?    @map("ionic_content")
      note            String?
      createdBy       String?  @map("created_by") @db.Uuid
      createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
      updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

      clinicalDrug ClinicalDrug             @relation(fields: [id], references: [id])
      generic      LocalConcept?            @relation("LocalConceptGeneric", fields: [genericId], references: [id])
      brands       LocalConcept[]           @relation("LocalConceptGeneric")
      ingredients  LocalConceptIngredient[]

      @@map("local_concept")
}

model LocalConceptIngredient {
      id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      localConceptId String        @map("local_concept_id") @db.Uuid
      ordinal        Int
      substanceUnii  String        @map("substance_unii")
      substanceName  String        @map("substance_name")
      basis          StrengthBasis @default(as_labeled)
      moietyUnii     String?       @map("moiety_unii")
      moietyName     String?       @map("moiety_name")
      strengthNumMag Decimal       @map("strength_num_mag") @db.Decimal
      strengthNumUom String        @map("strength_num_uom")
      strengthDenMag Decimal       @default(1) @map("strength_den_mag") @db.Decimal
      strengthDenUom String        @map("strength_den_uom")

      localConcept LocalConcept @relation(fields: [localConceptId], references: [id], onDelete: Cascade)

      @@unique([localConceptId, substanceUnii])
      @@map("local_concept_ingredient")
}

model Package {
      id            String     @id @db.Uuid
      type          EntityType @default(package)
      description   String?
      containerType String?    @map("container_type")
      billingUnit   String?    @map("billing_unit")
      isUnitOfUse   Boolean?   @map("is_unit_of_use")

      entity                    Entity                     @relation(fields: [id, type], references: [id, type])
      components                PackageComponent[]         @relation("ComponentParent")
      containedIn               PackageComponent[]         @relation("ComponentChild")
      formularyItemPackages     FormularyItemPackage[]
      packageCatalogProjections PackageCatalogProjection[]
      containerSpecs            ContainerSpec[]
      componentInUseLimits      ComponentInUseLimit[]
      slotCandidates            SlotCandidate[]
      componentCosts            ComponentCost[]
      componentAvailabilities   ComponentAvailability[]
      buildPlanLines            BuildPlanLine[]
      openComponents            OpenComponent[]

      @@unique([id, type])
      @@map("package")
}

model FormularyItem {
      id                  String     @id @db.Uuid
      type                EntityType @default(formulary_item)
      scopeId             String     @map("scope_id") @db.Uuid
      kind                String
      displayName         String     @map("display_name")
      /// User-chosen short form for a timed release ("SR", "XR"), replacing "Extended Release (12 HR)".
      releaseAbbreviation String?    @map("release_abbreviation")
      /// User replacement for the sourced name ("Glucose" → "Dextrose"); null shows the sourced name.
      nameOverride        String?    @map("name_override")
      /// Show a single amount-per-volume strength as a percentage ("12500 MG/250ML" → "5% 250ML").
      strengthAsPercent   Boolean    @default(false) @map("strength_as_percent")

      entity                Entity                 @relation(fields: [id, type], references: [id, type])
      scope                 Scope                  @relation(fields: [scopeId], references: [id])
      formularyItemPackages FormularyItemPackage[]
      compoundFormulas      CompoundFormula[]
      brands                FormularyItemBrand[]

      @@unique([id, type])
      @@map("formulary_item")
}

/// A brand-name tag on a formulary item. RxNorm rows are seeded from SBD → BN on load;
/// a dismissed RxNorm brand stays as a suppressed row so reloads never resurrect it.
model FormularyItemBrand {
      id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      formularyItemId String   @map("formulary_item_id") @db.Uuid
      name            String
      /// Lower-cased, whitespace-collapsed name; unique per item.
      nameKey         String   @map("name_key")
      rxcui           String?
      source          String
      suppressed      Boolean  @default(false)
      createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

      formularyItem FormularyItem @relation(fields: [formularyItemId], references: [id])

      @@unique([formularyItemId, nameKey])
      @@map("formulary_item_brand")
}

model FormularyItemPackage {
      id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      formularyItemId String                    @map("formulary_item_id") @db.Uuid
      packageId       String                    @map("package_id") @db.Uuid
      preferenceRank  Int                       @default(1) @map("preference_rank")
      validFrom       DateTime                  @default(now()) @map("valid_from") @db.Timestamptz(6)
      validTo         DateTime?                 @map("valid_to") @db.Timestamptz(6)
      /// @generated tstzrange(valid_from, valid_to)
      validPeriod     Unsupported("tstzrange")? @default(dbgenerated()) @map("valid_period")

      formularyItem FormularyItem @relation(fields: [formularyItemId], references: [id])
      package       Package       @relation(fields: [packageId], references: [id])

      @@map("formulary_item_package")
}

// ---------------------------------------------------------------------
// 2. Identifiers
// ---------------------------------------------------------------------
model IdentifierNamespace {
      code                String               @id
      appliesTo           EntityType[]         @map("applies_to")
      isDerived           Boolean              @default(false) @map("is_derived")
      normalizer          String?
      externalIdentifiers ExternalIdentifier[]

      @@map("identifier_namespace")
}

model ExternalIdentifier {
      id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      entityId        String                    @map("entity_id") @db.Uuid
      namespace       String
      value           String
      normalizedValue String                    @map("normalized_value")
      derivedFromId   String?                   @map("derived_from_id") @db.Uuid
      derivationRule  String?                   @map("derivation_rule")
      isPrimary       Boolean                   @default(false) @map("is_primary")
      validFrom       DateTime                  @default(now()) @map("valid_from") @db.Timestamptz(6)
      validTo         DateTime?                 @map("valid_to") @db.Timestamptz(6)
      /// @generated tstzrange(valid_from, valid_to)
      validPeriod     Unsupported("tstzrange")? @default(dbgenerated()) @map("valid_period")
      sourceRecordId  String?                   @map("source_record_id") @db.Uuid

      entity              Entity               @relation(fields: [entityId], references: [id])
      identifierNamespace IdentifierNamespace  @relation(fields: [namespace], references: [code])
      derivedFrom         ExternalIdentifier?  @relation("IdentifierDerivation", fields: [derivedFromId], references: [id])
      derivatives         ExternalIdentifier[] @relation("IdentifierDerivation")
      sourceRecord        SourceRecord?        @relation(fields: [sourceRecordId], references: [id])
      ndcSegments         NdcSegments[]

      @@index([entityId])
      @@index([namespace, normalizedValue])
      @@index([normalizedValue])
      @@map("external_identifier")
}

model NdcSegments {
      identifierId  String @id @map("identifier_id") @db.Uuid
      labelerCode   String @map("labeler_code")
      productCode   String @map("product_code")
      packageCode   String @map("package_code")
      configuration String

      identifier ExternalIdentifier @relation(fields: [identifierId], references: [id])

      @@map("ndc_segments")
}

// ---------------------------------------------------------------------
// 3. Units, package tree, strengths
// ---------------------------------------------------------------------
model UcumUnit {
      code          String          @id
      dimension     String
      toBase        Decimal?        @map("to_base") @db.Decimal
      ucumUnitAlias UcumUnitAlias[]

      @@map("ucum_unit")
}

model UcumUnitAlias {
      alias String @id
      code  String

      unit UcumUnit @relation(fields: [code], references: [code])

      @@map("ucum_unit_alias")
}

model PackageComponent {
      id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      parentPackageId String                    @map("parent_package_id") @db.Uuid
      childPackageId  String?                   @map("child_package_id") @db.Uuid
      childProductId  String?                   @map("child_product_id") @db.Uuid
      quantityMag     Decimal                   @map("quantity_mag") @db.Decimal
      quantityUom     String                    @map("quantity_uom")
      /// @generated measure(quantity_mag, quantity_uom)
      quantity        Unsupported("measure")?   @default(dbgenerated())
      ordinal         Int                       @default(1)
      validFrom       DateTime                  @default(now()) @map("valid_from") @db.Timestamptz(6)
      validTo         DateTime?                 @map("valid_to") @db.Timestamptz(6)
      /// @generated
      validPeriod     Unsupported("tstzrange")? @default(dbgenerated()) @map("valid_period")

      parentPackage Package  @relation("ComponentParent", fields: [parentPackageId], references: [id])
      childPackage  Package? @relation("ComponentChild", fields: [childPackageId], references: [id])
      childProduct  Product? @relation(fields: [childProductId], references: [id])

      @@index([parentPackageId])
      @@map("package_component")
}

model ProductIngredient {
      id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      productId         String                    @map("product_id") @db.Uuid
      ingredientId      String                    @map("ingredient_id") @db.Uuid
      basisIngredientId String?                   @map("basis_ingredient_id") @db.Uuid
      isActive          Boolean                   @default(true) @map("is_active")
      strengthNumMag    Decimal                   @map("strength_num_mag") @db.Decimal
      strengthNumUom    String                    @map("strength_num_uom")
      strengthDenMag    Decimal                   @default(1) @map("strength_den_mag") @db.Decimal
      strengthDenUom    String                    @map("strength_den_uom")
      /// @generated numerator measure (500 mg)
      strengthNum       Unsupported("measure")?   @default(dbgenerated()) @map("strength_num")
      /// @generated denominator measure (10 mL)
      strengthDen       Unsupported("measure")?   @default(dbgenerated()) @map("strength_den")
      /// @generated concentration measure (50 mg/mL) — comparable across units
      strength          Unsupported("measure")?   @default(dbgenerated())
      basis             StrengthBasis             @default(as_labeled)
      ordinal           Int                       @default(1)
      validFrom         DateTime                  @default(now()) @map("valid_from") @db.Timestamptz(6)
      validTo           DateTime?                 @map("valid_to") @db.Timestamptz(6)
      /// @generated
      validPeriod       Unsupported("tstzrange")? @default(dbgenerated()) @map("valid_period")

      product         Product     @relation(fields: [productId], references: [id])
      ingredient      Ingredient  @relation("ProductIngredientPrecise", fields: [ingredientId], references: [id])
      basisIngredient Ingredient? @relation("ProductIngredientBasis", fields: [basisIngredientId], references: [id])

      @@index([productId])
      @@map("product_ingredient")
}

model RelationshipType {
      code                String               @id
      fromType            EntityType           @map("from_type")
      toType              EntityType           @map("to_type")
      cardinality         String               @default("many")
      entityRelationships EntityRelationship[]

      @@map("relationship_type")
}

model EntityRelationship {
      id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      relationshipType String                    @map("relationship_type")
      fromEntityId     String                    @map("from_entity_id") @db.Uuid
      toEntityId       String                    @map("to_entity_id") @db.Uuid
      ordinal          Int                       @default(1)
      validFrom        DateTime                  @default(now()) @map("valid_from") @db.Timestamptz(6)
      validTo          DateTime?                 @map("valid_to") @db.Timestamptz(6)
      /// @generated
      validPeriod      Unsupported("tstzrange")? @default(dbgenerated()) @map("valid_period")
      sourceRecordId   String?                   @map("source_record_id") @db.Uuid

      type         RelationshipType @relation(fields: [relationshipType], references: [code])
      fromEntity   Entity           @relation("RelationshipFrom", fields: [fromEntityId], references: [id])
      toEntity     Entity           @relation("RelationshipTo", fields: [toEntityId], references: [id])
      sourceRecord SourceRecord?    @relation(fields: [sourceRecordId], references: [id])

      @@map("entity_relationship")
}

// ---------------------------------------------------------------------
// 4. Source evidence
// ---------------------------------------------------------------------
model Source {
      code           String          @id
      description    String?
      ingestionRuns  IngestionRun[]
      factAssertions FactAssertion[]
      entityMappings EntityMapping[]

      @@map("source")
}

model IngestionRun {
      id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      source        String
      sourceRelease String?   @map("source_release")
      parserVersion String    @map("parser_version")
      startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
      completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
      status        String    @default("running")

      sourceRef         Source          @relation(fields: [source], references: [code])
      mappingsFirstSeen EntityMapping[] @relation("MappingFirstSeen")
      mappingsLastSeen  EntityMapping[] @relation("MappingLastSeen")
      sourceRecords     SourceRecord[]
      resolutionRuns    ResolutionRun[]

      @@map("ingestion_run")
}

model SourceRecord {
      id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      ingestionRunId String   @map("ingestion_run_id") @db.Uuid
      sourceNativeId String   @map("source_native_id")
      sourceUrl      String?  @map("source_url")
      observedAt     DateTime @default(now()) @map("observed_at") @db.Timestamptz(6)
      payload        Json
      payloadHash    Bytes    @map("payload_hash")

      ingestionRun        IngestionRun         @relation(fields: [ingestionRunId], references: [id])
      externalIdentifiers ExternalIdentifier[]
      entityRelationships EntityRelationship[]
      factAssertions      FactAssertion[]
      entityMappings      EntityMapping[]
      containerSpecs      ContainerSpec[]
      compoundingRules    CompoundingRule[]
      stabilityStudies    StabilityStudy[]

      @@unique([ingestionRunId, sourceNativeId])
      /// Covers the latest-record lookup (run and id included) so it never reads the wide payload rows.
      @@index([sourceNativeId, observedAt(sort: Desc), ingestionRunId, id])
      @@index([payloadHash])
      @@map("source_record")
}

// ---------------------------------------------------------------------
// 5. Property registry, assertions, resolution
// ---------------------------------------------------------------------
model PropertyDefinition {
      id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      key              String
      majorVersion     Int         @default(1) @map("major_version")
      appliesTo        EntityType  @map("applies_to")
      valueType        ValueType   @map("value_type")
      cardinality      String      @default("one")
      /// required for quantity/rational: 'volume', 'mass/volume', 'time' ...
      unitDimension    String?     @map("unit_dimension")
      codeSystem       String?     @map("code_system")
      refEntityType    EntityType? @map("ref_entity_type")
      isGroupable      Boolean     @default(false) @map("is_groupable")
      isFilterable     Boolean     @default(true) @map("is_filterable")
      isSortable       Boolean     @default(false) @map("is_sortable")
      isDerived        Boolean     @default(false) @map("is_derived")
      reviewOnChange   String      @default("none") @map("review_on_change")
      displayConfig    Json        @default("{}") @map("display_config")
      validationSchema Json?       @map("validation_schema")
      deprecatedAt     DateTime?   @map("deprecated_at") @db.Timestamptz(6)
      replacedById     String?     @map("replaced_by") @db.Uuid

      replacedBy           PropertyDefinition?  @relation("PropertyReplacement", fields: [replacedById], references: [id])
      replaces             PropertyDefinition[] @relation("PropertyReplacement")
      factAssertions       FactAssertion[]
      resolutionPolicies   ResolutionPolicy[]
      propertyValues       PropertyValue[]
      reviewItems          ReviewItem[]
      derivations          Derivation[]
      derivationInputs     DerivationInput[]
      derivationDirties    DerivationDirty[]
      propertyGroupIndexes PropertyGroupIndex[]
      catalogViewLevels    CatalogViewLevel[]

      @@unique([key, majorVersion])
      @@map("property_definition")
}

model FactAssertion {
      id              String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
      sourceRecordId  String?                          @map("source_record_id") @db.Uuid
      source          String
      scopeId         String                           @map("scope_id") @db.Uuid
      entityId        String                           @map("entity_id") @db.Uuid
      propertyId      String                           @map("property_id") @db.Uuid
      ordinal         Int                              @default(1)
      textValue       String?                          @map("text_value")
      codeValue       String?                          @map("code_value")
      numberValue     Decimal?                         @map("number_value") @db.Decimal
      /// unit for quantity AND rational values (validated by measure functions, may be compound)
      unitCode        String?                          @map("unit_code")
      ratWhole        BigInt?                          @map("rat_whole")
      ratNum          BigInt?                          @map("rat_num")
      ratDen          BigInt?                          @map("rat_den")
      booleanValue    Boolean?                         @map("boolean_value")
      dateValue       DateTime?                        @map("date_value") @db.Date
      refEntityId     String?                          @map("ref_entity_id") @db.Uuid
      jsonValue       Json?                            @map("json_value")
      /// @generated measure(number_value, unit_code) when unit_code is set
      measureValue    Unsupported("measure")?          @default(dbgenerated()) @map("measure_value")
      /// @generated rational_measure(rat_whole, rat_num, rat_den, unit_code)
      rationalValue   Unsupported("rational_measure")? @default(dbgenerated()) @map("rational_value")
      isNullAssertion Boolean                          @default(false) @map("is_null_assertion")
      confidence      Decimal?                         @db.Decimal
      /// NULL = open (−∞)
      validFrom       DateTime?                        @map("valid_from") @db.Timestamptz(6)
      validTo         DateTime?                        @map("valid_to") @db.Timestamptz(6)
      /// @generated
      validPeriod     Unsupported("tstzrange")?        @default(dbgenerated()) @map("valid_period")
      assertedBy      String?                          @map("asserted_by") @db.Uuid
      justification   String?
      parserVersion   String?                          @map("parser_version")
      recordedAt      DateTime                         @default(now()) @map("recorded_at") @db.Timestamptz(6)
      retractedAt     DateTime?                        @map("retracted_at") @db.Timestamptz(6)

      sourceRecord   SourceRecord?      @relation(fields: [sourceRecordId], references: [id])
      sourceRef      Source             @relation(fields: [source], references: [code])
